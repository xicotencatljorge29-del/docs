<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DJ FESTER | Cyber-Perreo Neon</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Roboto:wght@400;700&family=Orbitron:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --neon-magenta: #ff00ff;
            --neon-cyan: #00ffff;
            --neon-mint: #98ff98; /* Color Menta Brillante */
            --dark-bg: #0d0d0d;
            --font-main: 'Roboto', sans-serif;
            --font-heading: 'Oswald', sans-serif;
            --font-tech: 'Orbitron', sans-serif;
        }

        body {
            font-family: var(--font-main);
            background-color: var(--dark-bg);
            color: #fff;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            position: relative;
        }

        .parallax-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, rgba(255, 0, 255, 0.1) 0%, transparent 50%), 
                        radial-gradient(circle at 50% 100%, rgba(0, 255, 255, 0.1) 0%, transparent 60%);
            z-index: -1;
            pointer-events: none;
            transition: transform 0.1s ease-out;
        }

        .hero {
            position: relative;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: url('imagenes/fondo-ia.jpg') no-repeat center center/cover;
            overflow: hidden;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            padding: 20px;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
        }

        .glitch-text {
            font-family: var(--font-tech);
            font-size: 5em;
            text-transform: uppercase;
            color: #fff;
            position: relative;
            animation: glitch 1s infinite;
            text-shadow: 0 0 15px var(--neon-magenta), 0 0 25px var(--neon-cyan);
        }

        .glitch-text::before, .glitch-text::after {
            content: attr(data-text);
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--dark-bg);
            overflow: hidden;
        }

        .glitch-text::before {
            left: 2px;
            text-shadow: -2px 0 var(--neon-magenta);
            animation: glitch-left 1s infinite;
        }

        .glitch-text::after {
            left: -2px;
            text-shadow: -2px 0 var(--neon-cyan);
            animation: glitch-right 1s infinite;
        }

        .subtitle {
            font-family: var(--font-tech);
            font-size: 1.5em;
            color: var(--neon-mint);
            margin-top: -20px;
        }

        .cta-text {
            font-size: 1.2em;
            margin-top: 20px;
            color: var(--neon-cyan);
            animation: pulse 2s infinite;
        }

        .cta-button {
            display: inline-block;
            margin-top: 30px;
            padding: 15px 40px;
            background: linear-gradient(45deg, var(--neon-magenta), var(--neon-cyan));
            color: #fff;
            text-transform: uppercase;
            font-weight: bold;
            text-decoration: none;
            border-radius: 50px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 2px solid var(--neon-magenta);
        }

        .cta-button:hover {
            transform: scale(1.1);
            box-shadow: 0 0 20px var(--neon-magenta), 0 0 20px var(--neon-cyan);
        }

        .section {
            padding: 80px 20px;
            text-align: center;
            max-width: 1200px;
            margin: auto;
            position: relative;
        }

        .section-title {
            font-family: var(--font-heading);
            font-size: 3em;
            text-transform: uppercase;
            margin-bottom: 40px;
            text-shadow: 0 0 10px var(--neon-mint);
            position: relative;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, var(--neon-magenta), var(--neon-cyan));
            margin: 10px auto 0;
            border-radius: 2px;
        }

        .dj-info-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 40px;
        }

        .dj-image {
            width: 250px;
            height: 250px;
            border-radius: 50%;
            border: 5px solid var(--neon-magenta);
            box-shadow: 0 0 20px var(--neon-magenta);
            transition: transform 0.5s ease-in-out;
        }

        .dj-text {
            max-width: 700px;
            font-size: 1.2em;
            line-height: 1.6;
        }

        .special-guests {
            background-color: rgba(13, 13, 13, 0.7);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .guest-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 40px;
        }

        .guest-card {
            text-align: center;
            width: 180px;
            padding: 20px;
            background-color: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--neon-cyan);
            border-radius: 10px;
            box-shadow: 0 0 15px var(--neon-cyan);
            transition: transform 0.3s ease;
        }

        .guest-card:hover {
            transform: translateY(-10px) scale(1.05);
            background-color: rgba(0, 255, 255, 0.1);
        }

        .guest-card img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--neon-magenta);
            box-shadow: 0 0 10px var(--neon-magenta
